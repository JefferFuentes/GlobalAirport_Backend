  "fechaNacimiento": "1990-01-01",
  "correo": "sin.token@email.com"
}


########################################################
# 7. ORDEN RECOMENDADO DE PRUEBA
########################################################

# 1. GET  /salud
# 2. POST /auth/login
# 3. Copiar el JWT en @token
# 4. GET  /auth/me
# 5. GET  /pasajeros
# 6. POST /pasajeros
# 7. Copiar el ID creado
# 8. GET  /pasajeros/{id}
# 9. PATCH /pasajeros/{id}
# 10. DELETE /pasajeros/{id} solamente para datos de prueba