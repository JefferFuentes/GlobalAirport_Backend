########################################################
# SUBSISTEMA 3: GESTIÓN DE PASAJEROS
########################################################

# Rutas disponibles:
#
# GET    /api/pasajeros
# GET    /api/pasajeros/:id
# POST   /api/pasajeros
# PATCH  /api/pasajeros/:id
# DELETE /api/pasajeros/:id
#
# Autorización:
#
# GET:
# - Cualquier usuario autenticado
#
# POST, PATCH y DELETE:
# - ADMIN_GENERAL
# - ADMIN_AEROPUERTO
# - EMPLEADO


########################################################
# 0. VERIFICAR EL BACKEND
########################################################

###
### Verificar que la API esté funcionando
GET {{baseUrl}}/salud


########################################################
# 1. AUTENTICACIÓN
########################################################

###
### Login del Administrador General
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "correo": "admin@globalairport.com",
  "password": "Admin12345"
}

###
### Verificar el usuario autenticado
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}


########################################################
# 2. CONSULTAR PASAJEROS
########################################################

###
### Listar todos los pasajeros
GET {{baseUrl}}/pasajeros
Authorization: Bearer {{token}}

###
### Obtener pasajero por ID
GET {{baseUrl}}/pasajeros/1
Authorization: Bearer {{token}}

###
### Consultar pasajero inexistente
### Debe responder 404 si el controlador lo maneja
GET {{baseUrl}}/pasajeros/99999
Authorization: Bearer {{token}}


########################################################
# 3. CREAR PASAJEROS
########################################################

###
### Crear pasajero costarricense con cédula
POST {{baseUrl}}/pasajeros
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombreCompleto": "Ana Maria Mora Vargas",
  "tipoDocumento": "CEDULA",
  "numeroDocumento": "101110111",
  "nacionalidad": "Costa Rica",
  "fechaNacimiento": "1998-05-10",
  "correo": "ana.mora@email.com"
}

###
### Crear pasajero costarricense con pasaporte
POST {{baseUrl}}/pasajeros
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombreCompleto": "Carlos Alberto Ramirez Soto",
  "tipoDocumento": "PASAPORTE",
  "numeroDocumento": "CR1234567",
  "nacionalidad": "Costa Rica",
  "fechaNacimiento": "1990-09-21",
  "correo": "carlos.ramirez@email.com"
}

###
### Crear pasajero extranjero
POST {{baseUrl}}/pasajeros
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombreCompleto": "Michael Robert Johnson",
  "tipoDocumento": "PASAPORTE",
  "numeroDocumento": "US987654321",
  "nacionalidad": "Estados Unidos",
  "fechaNacimiento": "1985-11-15",
  "correo": "michael.johnson@email.com"
}

###
### Crear pasajero menor de edad
POST {{baseUrl}}/pasajeros
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombreCompleto": "Sofia Herrera Castro",
  "tipoDocumento": "PASAPORTE",
  "numeroDocumento": "CR-MENOR-001",
  "nacionalidad": "Costa Rica",
  "fechaNacimiento": "2012-06-20",
  "correo": "sofia.herrera@email.com"
}


########################################################
# 4. ACTUALIZAR PASAJEROS
########################################################

###
### Actualizar correo del pasajero
PATCH {{baseUrl}}/pasajeros/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "correo": "ana.mora.actualizado@email.com"
}

###
### Actualizar nombre completo
PATCH {{baseUrl}}/pasajeros/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombreCompleto": "Ana Maria Mora Vargas de Rodriguez"
}

###
### Actualizar nacionalidad
PATCH {{baseUrl}}/pasajeros/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nacionalidad": "Costa Rica"
}

###
### Actualizar documento
PATCH {{baseUrl}}/pasajeros/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tipoDocumento": "PASAPORTE",
  "numeroDocumento": "CR7654321"
}

###
### Actualizar fecha de nacimiento
PATCH {{baseUrl}}/pasajeros/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fechaNacimiento": "1998-05-11"
}

###
### Actualizar todos los datos del pasajero
PATCH {{baseUrl}}/pasajeros/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombreCompleto": "Ana Maria Mora Vargas",
  "tipoDocumento": "CEDULA",
  "numeroDocumento": "101110111",
  "nacionalidad": "Costa Rica",
  "fechaNacimiento": "1998-05-10",
  "correo": "ana.mora@email.com"
}


########################################################
# 5. ELIMINAR PASAJEROS
########################################################

###
### Eliminar pasajero por ID
### Puede fallar si tiene reservaciones relacionadas
DELETE {{baseUrl}}/pasajeros/4
Authorization: Bearer {{token}}

###
### Intentar eliminar pasajero inexistente
DELETE {{baseUrl}}/pasajeros/99999
Authorization: Bearer {{token}}


